// Cloudflare Workers: prototyp (strona statyczna SPA) + czytnik portali pod /api/check.
// Build: `npm run build` (folder dist), deploy: `npx wrangler deploy`.
{
  "name": "radar-grantow",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
